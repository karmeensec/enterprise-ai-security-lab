
# AEGIS local container configuration
# Copy this file to .env and fill in the values.

DASHBOARD_USERNAME=analyst
DASHBOARD_PASSWORD=

# Explicit agent access.
# Empty list means no case access.
AGENT_CASE_ACCESS_JSON={"analyst":[]}

# Random secret for stable pseudonymized audit correlation.
AEGIS_AUDIT_PSEUDONYM_KEY=

# Existing monitoring API authentication.
MONITOR_API_KEY=

# No real response-action execution.
RESPONSE_APPROVER_USERS=
